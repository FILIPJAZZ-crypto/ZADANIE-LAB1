<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp">
    <ImageView android:id="@+id/taskIcon" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_task" android:contentDescription="Ikona zadania" android:layout_alignParentStart="true"/>
    <ImageView android:id="@+id/stateIcon" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_check" android:contentDescription="Stan" android:layout_alignParentEnd="true"/>
    <TextView android:id="@+id/taskTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zadanie do wykonania" android:textStyle="bold" android:textSize="18sp"
        android:layout_toEndOf="@id/taskIcon" android:layout_toStartOf="@id/stateIcon" android:layout_marginStart="12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opis zadania znajduje się tutaj."
        android:layout_below="@id/taskTitle" android:layout_toEndOf="@id/taskIcon" android:layout_toStartOf="@id/stateIcon" android:layout_marginStart="12dp"/>
</RelativeLayout>
